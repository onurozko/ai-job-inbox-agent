# Application
APP_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required in production — use a long random value (32+ bytes for HS256)
SECRET_KEY=change-me-in-production

# JWT auth
JWT_EXPIRE_MINUTES=10080
OAUTH_STATE_EXPIRE_MINUTES=10
AUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://jobinbox:jobinbox@localhost:5432/jobinbox

# OpenAI / PydanticAI
OPENAI_API_KEY=

# Google OAuth (Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GMAIL_CONNECT_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback

# CORS (comma-separated origins, or * for development)
CORS_ORIGINS=*

# Background email sync (requires users to connect Gmail via OAuth first)
ENABLE_BACKGROUND_SYNC=false
BACKGROUND_SYNC_INTERVAL_MINUTES=30
BACKGROUND_SYNC_MAX_RESULTS=25
